"""Tests for image generation endpoint."""

from unittest.mock import MagicMock

import pytest


def test_generate_image_success(client, api_key_headers, mock_storage, mock_job_manager, mock_model_manager):
    """Test successful image generation request (Async)."""
    payload = {
        "job_id": "test-job-1",
        "prompt": "A beautiful sunset",
        "aspect_ratio": "16:9",
        "save_url": "https://r2.example.com/output.png"
    }
    
    # 1. Initiate Generation
    response = client.post("/api/v1/image/generate", headers=api_key_headers, json=payload)
    
    # Assert accepted
    assert response.status_code == 202
    data = response.json()
    assert data["job_id"] == "test-job-1"
    assert "status_url" in data
    
    # 2. Poll for completion
    # Since we are using MockGenerator (synchronous mock in background thread), 
    # it should complete almost immediately.
    import time
    max_retries = 10
    
    for _ in range(max_retries):
        status_response = client.get(f"/api/v1/jobs/test-job-1", headers=api_key_headers)
        assert status_response.status_code == 200
        status_data = status_response.json()
        
        if status_data["status"] in ["completed", "failed"]:
            break
        time.sleep(0.1)
        
    assert status_data["status"] == "completed"
    assert status_data["result"]["save_url"] == "https://r2.example.com/output.png"


def test_generate_image_with_output_url(client, api_key_headers, mock_storage, sample_job_id, mock_model_manager):
    """Test image generation with a custom output URL."""
    custom_url = "https://custom-storage.com/upload/here?token=123"
    response = client.post(
        "/api/v1/image/generate",
        headers=api_key_headers,
        json={
            "job_id": sample_job_id,
            "prompt": "A beautiful sunset",
            "save_url": custom_url,
        },
    )

    assert response.status_code == 200
    data = response.json()
    assert data["status"] == "completed"
    assert data["save_url"] == custom_url

    # Verify storage call
    mock_storage.upload_to_url.assert_called_once()


def test_generate_image_custom_dimensions(client, api_key_headers, mock_storage, sample_job_id, mock_model_manager):
    """Test image generation with custom width and height."""
    response = client.post(
        "/api/v1/image/generate",
        headers=api_key_headers,
        json={
            "job_id": sample_job_id,
            "prompt": "A beautiful sunset",
            "width": 512,
            "height": 512,
            "save_url": "https://example.com/save.png",
        },
    )

    assert response.status_code == 200
    data = response.json()
    assert data["status"] == "completed"


def test_generate_image_custom_dimensions_validation(client, api_key_headers, mock_model_manager):
    """Test validation for custom dimensions."""
    # Case 1: Only width provided
    response = client.post(
        "/api/v1/image/generate",
        headers=api_key_headers,
        json={
            "job_id": "test-job",
            "prompt": "test",
            "width": 512,
            "save_url": "http://save.com",
        },
    )
    assert response.status_code == 400  # Custom validation handler returns 400

    # Case 2: Out of range
    response = client.post(
        "/api/v1/image/generate",
        headers=api_key_headers,
        json={
            "job_id": "test-job",
            "prompt": "test",
            "width": 100,
            "height": 100,
            "save_url": "http://save.com",
        },
    )
    assert response.status_code == 400

    # Case 3: Too large
    response = client.post(
        "/api/v1/image/generate",
        headers=api_key_headers,
        json={
            "job_id": "test-job",
            "prompt": "test",
            "width": 2000,
            "height": 2000,
            "save_url": "http://save.com",
        },
    )
    assert response.status_code == 400


def test_generate_image_invalid_aspect_ratio(client, api_key_headers, mock_job_manager, mock_model_manager):
    """Test validation error for invalid aspect ratio."""
    response = client.post(
        "/api/v1/image/generate",
        headers=api_key_headers,
        json={
            "job_id": "test-job",
            "prompt": "sunset",
            "aspect_ratio": "invalid-ratio",
        },
    )

    assert response.status_code == 400

    assert response.status_code == 400
    data = response.json()
    assert data["status"] == "failed"
    assert data["error_code"] == "VALIDATION_ERROR"


def test_generate_image_unauthorized(client):
    """Test unauthorized access (missing API key)."""
    response = client.post(
        "/api/v1/image/generate",
        json={
            "job_id": "test-job",
            "prompt": "sunset",
        },
    )

    assert response.status_code == 401
    data = response.json()
    assert data["error_code"] == "MISSING_API_KEY"


def test_generate_image_invalid_key(client, invalid_api_key_headers):
    """Test access with invalid API key."""
    response = client.post(
        "/api/v1/image/generate",
        headers=invalid_api_key_headers,
        json={
            "job_id": "test-job",
            "prompt": "sunset",
        },
    )

    assert response.status_code == 401
    data = response.json()
    assert data["error_code"] == "INVALID_API_KEY"
