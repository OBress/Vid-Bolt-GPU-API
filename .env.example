# Vid-Bolt GPU API - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# MOCK MODE (acts as dry-run for all generators)
# =============================================================================
# true  = Use mock generators, no GPU needed (for development/testing)
# false = Load real AI models on GPU (production)
MOCK_MODE=true

# =============================================================================
# API AUTHENTICATION
# =============================================================================
# API key for authenticating requests (required in production)
# Generate a secure random string: openssl rand -hex 32
API_KEY=SQh1R5s4J5GBFUQLQhQup06EjVvscpLTvtVapHF7Iewja3yWoUPkUdZAKsDTRB246RaW6ldjj14C3qLcyD63b87qFM7CNxYuZAXmYtd6nLqWkiHF2HvIJg5oGWY8vrmh

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# MODEL MODE (optional)
# =============================================================================
# Default mode on startup: "image" or "video"
# image = Load Z-Image + Qwen-Image-Edit (for image generation/editing)
# video = Load LTX-2 + Stream-DiffVSR (for video generation)
DEFAULT_MODEL_MODE=image
