# Vid-Bolt GPU API - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# MOCK MODE (acts as dry-run for all generators)
# =============================================================================
# true  = Use mock generators, no GPU needed (for development/testing)
# false = Load real AI models on GPU (production)
MOCK_MODE=false

# =============================================================================
# API AUTHENTICATION
# =============================================================================
# API key for authenticating requests (required in production)
# Generate a secure random string: openssl rand -hex 32
API_KEY=HnD4zjuE4UijyPVP3HDTm4kaf9kVDrpnToZ68GSzzKRVcS2LnEVbvBJhUy8nr2TVi35pnW0jNjG3EojgmWc9YpQcB27ZEUtF1LZqfKlJWMWmTE1Ztk46PljypIrbeqC1

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# MODEL MODE (optional)
# =============================================================================
# Default mode on startup: "image" or "video"
# image = Load Z-Image + Qwen-Image-Edit (for image generation/editing)
# video = Load LTX-2 + Stream-DiffVSR (for video generation)
DEFAULT_MODEL_MODE=image


# GITHUB access token for cloning private repositories
GITHUB_ACCESS_TOKEN=


# HuggingFace Token for downloading gated models (Gemma text encoder)
HF_TOKEN=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