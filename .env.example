# Vid-Bolt GPU API Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# MOCK MODE
# =============================================================================
# Set to true for local development with mock implementations
# Set to false when running with Z-Image model (requires GPU)
MOCK_MODE=true

# =============================================================================
# API AUTHENTICATION
# =============================================================================
# API key for authenticating requests (required)
# Generate a secure random string for production
API_KEY=your-secure-api-key-here

# =============================================================================
# COMFYUI SETTINGS (for future use)
# =============================================================================
# ComfyUI server host
COMFY_HOST=127.0.0.1

# ComfyUI server port
COMFY_PORT=8188

# =============================================================================
# LIMITS
# =============================================================================
# Maximum upload size for images in MB
MAX_IMAGE_SIZE_MB=10

# Maximum video duration in seconds
MAX_VIDEO_DURATION_SECONDS=8

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of allowed origins
# For local development: http://localhost:3000
# For production: https://vidbolt.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Z-IMAGE SETTINGS (only used when MOCK_MODE=false)
# =============================================================================
# Path to Z-Image model directory (relative to project root)
ZIMAGE_MODEL_PATH=models/z-image-turbo

# Path to LoRA weights directory
ZIMAGE_LORA_PATH=models/loras

# Device to run inference on (cuda, cpu, mps)
ZIMAGE_DEVICE=cuda

# Data type for model weights (bfloat16 or float16)
ZIMAGE_DTYPE=bfloat16

# Enable torch.compile for faster inference (slower first run)
ZIMAGE_COMPILE=false

# Attention backend (_native_flash, flash, _flash_3, sdpa)
ZIMAGE_ATTENTION_BACKEND=_native_flash

# DRY RUN MODE: Set to true to test workflow without loading actual models
# Useful for verifying API integration before deploying to GPU server
ZIMAGE_DRY_RUN=false

# =============================================================================
# LIGHTX2V SETTINGS (Qwen-Image-Edit-2511)
# =============================================================================
# Path to Qwen-Image-Edit-2511 model directory
LIGHTX2V_MODEL_PATH=models/qwen-image-edit-2511

# Path to distilled LORA weights directory
LIGHTX2V_LORA_PATH=models/loras/qwen-image-edit-2511

# LORA filename (the 8-step distilled LORA)
LIGHTX2V_LORA_FILENAME=Qwen-Image-Edit-2511-Lightning-8steps-V1.0-fp32.safetensors

# Device for inference (cuda, cpu)
LIGHTX2V_DEVICE=cuda

# Attention mode (flash_attn2, flash_attn3, sage_attn2)
# flash_attn3 recommended for best performance on Ampere+ GPUs
LIGHTX2V_ATTN_MODE=flash_attn3

# Inference steps (8 with LORA, 40 for base model)
LIGHTX2V_INFER_STEPS=8

# Guidance scale (1.0 = no CFG, distilled LORA doesn't need CFG)
LIGHTX2V_GUIDANCE_SCALE=1.0

# Resize mode for input images (adaptive recommended)
LIGHTX2V_RESIZE_MODE=adaptive

# Dry run mode (test workflow without loading actual models)
LIGHTX2V_DRY_RUN=false

# CPU offloading for lower VRAM usage
LIGHTX2V_CPU_OFFLOAD=false

# Offload text encoder to CPU (recommended for 16GB VRAM GPUs)
LIGHTX2V_TEXT_ENCODER_OFFLOAD=true
